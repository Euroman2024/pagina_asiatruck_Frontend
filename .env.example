# Copiar como .env.local (en local) o configurar en Vercel > Settings > Environment Variables.

# Dirección del backend de la página web (NestJS)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Acceso con Google: mismo ID de cliente que GOOGLE_CLIENT_ID del backend.
# Mientras esté vacío, el botón "Continuar con Google" no se muestra.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# El stock lo controla el kárdex del sistema de proformas: en el panel es de solo lectura
NEXT_PUBLIC_STOCK_DESDE_PROFORMAS=1
